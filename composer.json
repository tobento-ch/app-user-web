{
    "name": "tobento/app-user-web",
    "version": "2.0.1",
    "type": "library",
    "description": "User web support for the app providing features such as login, registration, password reset, logout and more.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "user",
        "login",
        "logout",
        "registration",
        "auth",
        "profile"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-message": "^2.0",
        "tobento/app-rate-limiter": "^2.0",
        "tobento/app-user": "^2.0",
        "tobento/app-notifier": "^2.0",
        "tobento/app-language": "^2.0",
        "tobento/app-translation": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/app-event": "^2.0",
        "tobento/app-spam": "^2.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-testing": "^2.0",
        "tobento/app-console": "^2.0",
        "tobento/app-logging": "^2.0",
        "tobento/app-profiler": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\User\\Web\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\User\\Web\\Test\\": "tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}